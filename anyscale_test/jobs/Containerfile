FROM anyscale/ray:2.44.1-py311

ENV ANYSCALE_DISABLE_OPTIMIZED_RAY=1

USER root
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*
USER ray

WORKDIR /home/ray

# Copy the modified Ray files
COPY python/ray/data/_internal/shuffle_memory_estimate.py /tmp/ray_patches/
COPY python/ray/data/_internal/shuffle_memory_estimator.py /tmp/ray_patches/
COPY python/ray/data/_internal/execution/operators/hash_shuffle.py /tmp/ray_patches/
COPY python/ray/data/dataset.py /tmp/ray_patches/
COPY python/ray/data/context.py /tmp/ray_patches/

# Patch the installed Ray
RUN SITE_PACKAGES=$(python -c "import site; print(site.getsitepackages()[0])") && \
    cp /tmp/ray_patches/shuffle_memory_estimate.py $SITE_PACKAGES/ray/data/_internal/ && \
    cp /tmp/ray_patches/shuffle_memory_estimator.py $SITE_PACKAGES/ray/data/_internal/ && \
    cp /tmp/ray_patches/hash_shuffle.py $SITE_PACKAGES/ray/data/_internal/execution/operators/ && \
    cp /tmp/ray_patches/dataset.py $SITE_PACKAGES/ray/data/ && \
    cp /tmp/ray_patches/context.py $SITE_PACKAGES/ray/data/

WORKDIR /home/ray
